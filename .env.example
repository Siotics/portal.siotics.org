# Next.js reads this file. Auth itself runs inside Convex, so copy the
# server secrets onto the deployment after you fill them in:
#   pnpm exec convex env set --from-file .env.local
#
# Do not commit .env.local.

# Written by `pnpm exec convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Convex site URL. Same deployment as NEXT_PUBLIC_CONVEX_URL, but the host ends in .convex.site.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public app origin. No trailing slash. Must match SITE_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex deployment
SITE_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth. Redirect URI: {SITE_URL}/api/auth/callback/google
# First Google sign-in creates a user with role=member.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Single Siotics IDP OIDC provider. First sign-in creates a user with role=admin.
# Redirect URI: {SITE_URL}/api/auth/oauth2/callback/{ADMIN_OIDC_PROVIDER_ID}
# ADMIN_OIDC_DISCOVERY_URL must be the OpenID document, not the issuer root:
#   https://your-idp.example/.well-known/openid-configuration
# Or set only ADMIN_OIDC_ISSUER and that document URL is derived.
# If both are set, ADMIN_OIDC_ISSUER must match the issuer in the discovery document.
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_DISCOVERY_URL=
ADMIN_OIDC_ISSUER=
# Optional. Default: openid,email,profile
ADMIN_OIDC_SCOPES=openid,email,profile
# Optional. Default: siotics. Cannot be "google".
ADMIN_OIDC_PROVIDER_ID=siotics
